{
  "name": "coretax-xml",
  "version": "0.1.0",
  "description": "Buat dan validasi file XML impor Coretax DJP (faktur pajak keluaran) langsung dari data aplikasi, dengan pesan error Bahasa Indonesia",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "fast-check": "^4.0.0",
    "tsup": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuikww/coretax-xml.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cuikww/coretax-xml#readme",
  "bugs": "https://github.com/cuikww/coretax-xml/issues",
  "keywords": [
    "coretax",
    "djp",
    "pajak",
    "faktur pajak",
    "e-faktur",
    "efaktur",
    "xml",
    "ppn",
    "indonesia",
    "tax invoice",
    "e-invoicing",
    "npwp",
    "nitku"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
