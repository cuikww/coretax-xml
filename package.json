{
  "name": "coretax-xml-monorepo",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "katalog": "pnpm build && node scripts/buat-katalog-error.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
